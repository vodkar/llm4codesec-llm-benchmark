    "experiment_plans": {
        "quick_test": {
            "description": "Quick test with limited samples for development",
            "sample_limit": 20,
            "datasets": [
                "binary_d2a"
            ],
            "models": [
                "qwen3-4b"
            ],
            "prompts": [
                "basic_security"
            ]
        },
        "basic_evaluation": {
            "description": "Basic evaluation across all datasets with one model",
            "sample_limit": null,
            "datasets": [
                "binary_d2a",
                "binary_ctf",
                "binary_magma",
                "binary_big_vul",
                "binary_devign"
            ],
            "models": [
                "qwen3-4b"
            ],
            "prompts": [
                "basic_security",
                "detailed_analysis"
            ]
        },
        "prompt_comparison": {
            "description": "Compare different prompt strategies on D2A dataset",
            "sample_limit": null,
            "datasets": [
                "binary_d2a",
                "multiclass_d2a"
            ],
            "models": [
                "qwen3-4b"
            ],
            "prompts": [
                "basic_security",
                "detailed_analysis",
                "step_by_step",
                "vulnerability_focused",
                "cwe_classification"
            ]
        },
        "model_comparison": {
