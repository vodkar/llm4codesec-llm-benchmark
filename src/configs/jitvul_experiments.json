            "temperature": 0.1,
            "use_quantization": true
        },
        "llama4-scout-17b-16e": {
            "model_name": "meta-llama/Llama-4-Scout-17B-16E-Instruct",
            "model_type": "LLAMA",
            "batch_size": 1,
            "max_tokens": 512,
            "temperature": 0.1,
            "use_quantization": true
        },
        "gemma3-1b": {
            "model_name": "google/gemma-3-1b-it",
            "model_type": "GEMMA",
            "batch_size": 1,
            "max_tokens": 512,
            "temperature": 0.1,
            "use_quantization": true
        },
        "gemma3-27b": {
            "model_name": "google/gemma-3-27b-it",
            "model_type": "GEMMA",
            "batch_size": 1,
            "max_tokens": 512,
            "temperature": 0.1,
            "use_quantization": true
        }
    },
    "experiment_plans": {
        "quick_test": {
            "description": "Quick test with limited samples for development",
            "datasets": [
                "binary_all",
                "multiclass_all"
            ],
            "models": [
                "qwen3-4b",
                "llama3.2-3B",
                "gemma3-1b",
                "deepseek-r1-distill-qwen2.5-1.5b"
            ],
            "prompts": [
                "basic_security",
                "detailed_analysis",
                "context_aware"
            ],
            "sample_limit": 10
        },
        "prompt_comparison": {
            "description": "Compare different prompt strategies",
            "datasets": [
                "binary_all"
            ],
            "models": [
                "qwen3-4b"
            ],
            "prompts": [
                "basic_security",
                "detailed_analysis",
                "context_aware"
            ],
            "sample_limit": null
        },
        "model_comparison": {
            "description": "Compare different model sizes",
            "datasets": [
                "binary_all"
            ],
            "models": [
                "qwen3-4b",
                "qwen3-30b",
                "llama3.2-3B"
            ],
            "prompts": [
                "basic_security"
            ],
            "sample_limit": null
        },
        "cwe_specific_analysis": {
            "description": "CWE-specific vulnerability detection",
            "datasets": [
                "cwe_125",
                "cwe_787"
            ],
            "models": [
                "qwen3-4b",
                "deepseek-coder-v2-lite-16b"
            ],
            "prompts": [
                "cwe_focused"
            ],
            "sample_limit": null
        },
        "comprehensive_evaluation": {
            "description": "Full evaluation across all datasets and models",
            "datasets": [
                "binary_all",
                "multiclass_all",
                "cwe_125",
                "cwe_787"
            ],
            "models": [
                "qwen3-4b",
                "qwen3-30b",
                "qwen3-30b-thinking",
                "deepseek-coder-v2-lite-16b",
                "deepseek-r1-distill-qwen2.5-32b",
                "deepseek-r1-distill-qwen2.5-1.5b",
                "wizard-coder-34b",
                "llama4-scout-17b-16e",
                "gemma3-27b",
                "gemma3-1b",
                "llama3.2-3B"
            ],
            "prompts": [
                "basic_security",
                "detailed_analysis"
            ],
            "sample_limit": null
        }
    },
    "output_settings": {
        "base_output_dir": "results/jitvul_experiments",
        "create_subdirs": true,
        "save_predictions": true,
        "save_metrics": true,
        "save_detailed_report": true,
        "include_timestamp": true
    },
    "evaluation_settings": {
        "metrics": [
            "accuracy",
            "precision",
            "recall",
            "f1",
            "auc"
        ],
        "calculate_per_cwe": true,
        "create_confusion_matrix": true,
        "analyze_errors": true
    }
}