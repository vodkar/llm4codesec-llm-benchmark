    "experiment_plans": {
        "quick_test": {
            "description": "Quick test with limited samples for development",
            "datasets": [
                "binary_c_file",
                "multiclass_c_file"
            ],
            "models": [
                "qwen3-4b",
                "llama3.2-3B",
                "gemma3-1b",
                "deepseek-r1-distill-qwen2.5-1.5b"
            ],
            "prompts": [
                "basic_security",
                "detailed_analysis",
                "context_aware"
            ],
            "sample_limit": 10
        },
        "prompt_comparison": {
            "description": "Compare different prompt strategies",
            "datasets": [
                "binary_c_file"
            ],
            "models": [
